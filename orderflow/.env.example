# Copy this file to .env and fill it in. .env is git-ignored — never commit it.
#
# tastytrade credentials. The API is free with an account; the CME data
# subscription is enabled in tastytrade's own settings, not here.
TT_LOGIN=your@email.com
TT_PASSWORD=your-password

# Optional. After the first successful login the API issues a remember token
# that can replace the password for subsequent sessions. Set it and clear
# TT_PASSWORD if you would rather not keep the password on disk.
# TT_REMEMBER_TOKEN=

# Optional overrides
# TT_URL=https://api.tastyworks.com     # api.cert.tastyworks.com for sandbox
# TT_DEPTH=20                           # depth-of-market levels to request
# GAMMA_UNDERLYING=QQQ                  # which chain builds the gamma map
