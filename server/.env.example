PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables real walkable street-level rounds instead of the
# curated-landmark photo fallback, using Mapillary (owned by Meta) — free,
# no billing account or credit card needed. Just:
#   1. Create a free account at mapillary.com
#   2. Go to mapillary.com/dashboard/developers and register an app
#   3. Copy the "Client Token" it gives you
# The same token is used both server-side (to search for images) and
# client-side (to render the viewer), so only one value is needed.
MAPILLARY_ACCESS_TOKEN=
