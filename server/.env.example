PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables real walkable Street View rounds instead of the
# curated-landmark photo fallback. Needs a Google Cloud project with
# billing enabled (free tier covers hobby use) and these APIs turned on:
# Street View Static API, Geocoding API, Maps JavaScript API.
# Server-side key (used for Street View metadata + reverse geocoding lookups):
GOOGLE_MAPS_API_KEY=
# Client-side key (loaded in the browser to render the Street View panorama;
# restrict it to your site's HTTP referrer in Google Cloud Console):
GOOGLE_MAPS_BROWSER_KEY=
