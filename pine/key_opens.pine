//@version=6
indicator("Key Opens", overlay = true, max_lines_count = 20, max_labels_count = 20)

// Opening price of the 18:00, 00:00, 02:00, 06:00 and 10:00 candles,
// New York clock (UTC-4), held as horizontal levels.
TZ = "UTC-4"

h       = hour(time, TZ)
newHour = na(h[1]) ? false : h != h[1]
isKey   = h == 18 or h == 0 or h == 2 or h == 6 or h == 10

barMs = timeframe.in_seconds() * 1000

var line[]  lines  = array.new_line()
var label[] labels = array.new_label()

// 18:00 opens the futures day: clear the old session, then draw its own level.
if newHour and h == 18
    while array.size(lines) > 0
        line.delete(array.pop(lines))
    while array.size(labels) > 0
        label.delete(array.pop(labels))

if newHour and isKey
    array.push(lines, line.new(time, open, time + barMs, open, xloc = xloc.bar_time, extend = extend.right, color = color.white, width = 1, style = line.style_dashed))
    array.push(labels, label.new(time, open, str.format("[{0,number,00}:00]", h), xloc = xloc.bar_time, style = label.style_none, textcolor = #b03030, size = size.normal))

// Park the labels just right of the last bar so they ride the edge.
if barstate.islast
    for i = 0 to array.size(labels) - 1
        label.set_x(array.get(labels, i), time + 6 * barMs)
