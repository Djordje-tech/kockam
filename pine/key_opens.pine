//@version=6
indicator("Key Opens — NY (UTC-4) — today only", overlay = true, max_lines_count = 20)

// Fixed to New York clock, UTC-4.
TZ = "UTC-4"

lineColor = input.color(color.new(color.white, 0), "Line color")
lineWidth = input.int(1, "Line width", minval = 1, maxval = 4)

// ── Detect the first bar of each key hour ─────────────────────────────────────
h       = hour(time, TZ)
newHour = na(h[1]) ? false : h != h[1]
isKey   = h == 0 or h == 2 or h == 6 or h == 10 or h == 18

// New calendar day on the NY clock wipes yesterday's lines: only today is drawn.
d      = dayofmonth(time, TZ)
newDay = na(d[1]) ? false : d != d[1]

validTF = timeframe.isintraday and timeframe.in_seconds() <= 3600

// ── Draw ──────────────────────────────────────────────────────────────────────
var line[] lines = array.new_line()

if newDay
    while array.size(lines) > 0
        line.delete(array.pop(lines))

if validTF and newHour and isKey
    // anchored at the candle's open price, extended both ways = full-height vertical
    l = line.new(x1 = time, y1 = open, x2 = time, y2 = open + syminfo.mintick, xloc = xloc.bar_time, extend = extend.both, color = lineColor, width = lineWidth, style = line.style_solid)
    array.push(lines, l)
